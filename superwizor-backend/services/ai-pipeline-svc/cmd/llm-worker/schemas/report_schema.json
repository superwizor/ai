{
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Krótki, opisowy tytuł raportu (max 100 znaków)"
    },
    "summary_short": {
      "type": "string",
      "description": "Streszczenie sesji w 2-3 zdaniach (max 500 znaków)"
    },
    "speaker_role_inference": {
      "type": "object",
      "description": "Wynik diaryzacji wykonanej przez LLM.",
      "properties": {
        "method": {
          "type": "string",
          "enum": ["llm_inferred", "native_chirp_3"]
        },
        "speaker_groups": {
          "type": "array",
          "description": "Lista zdedukowanych mówców. Każdy chunk powinien należeć do dokładnie jednej grupy.",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": ["therapist", "patient", "couple_partner", "family_member_parent", "family_member_child", "family_member_sibling", "third_party"]
              },
              "chunk_indices": {
                "type": "array",
                "items": {"type": "integer"}
              },
              "confidence": {
                "type": "number"
              },
              "evidence": {
                "type": "string"
              }
            },
            "required": ["role", "chunk_indices", "confidence", "evidence"]
          }
        },
        "overall_diarization_confidence": {
          "type": "number"
        }
      },
      "required": ["method", "speaker_groups", "overall_diarization_confidence"]
    },
    "rag_summary_chunk": {
      "type": "string",
      "description": "Krótkie streszczenie kluczowych informacji do zapisu w RAG memory (max 1500 znaków). NIE zawierać danych identyfikujących."
    },
    "rag_themes": {
      "type": "array",
      "items": {"type": "string"},
      "description": "2-5 odrębnych wątków klinicznych TEJ sesji (np. 'lęk przed matką', 'stres w pracy'), każdy 2-3 zdania, do pamięci długoterminowej. BEZ danych identyfikujących, w 3. osobie. Pomiń gdy materiał zbyt krótki."
    }
  },
  "required": [
    "title", "summary_short", "speaker_role_inference", "rag_summary_chunk"
  ]
}
