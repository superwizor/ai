# Binaries
bin/
*.exe

# Compiled service binaries (built locally; production uses Cloud Build).
# Mirrors cmd/<name>/main.go output names that sometimes end up at the
# service root when `go build` is run without -o.
services/*/server
services/*/main
services/*/billing-svc
services/*/llm-worker
services/*/stt-worker
services/*/identity-svc
services/*/clinical-svc
services/*/ingestion-svc
services/*/analytics-svc
services/*/notification-svc
services/*/api

# Test coverage
cov.out
coverage.html

# Go module cache
vendor/

# Terraform (routinely contains plaintext secrets)
*.tfstate
*.tfstate.backup
# epoch-suffixed backups (e.g. terraform.tfstate.1777855217.backup) — the bare
# *.tfstate.backup glob above does NOT match these; these globs do.
*.tfstate.*
terraform.tfstate.*.backup
*.tfvars
.terraform/
.terragrunt-cache/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Secrets
*.json
!buf.gen.yaml
!*.example.json
# Modality prompt specs are source-of-truth for the migration generator
# (see migrations/add_modality.py). Not secrets — must be tracked.
!migrations/modality_prompts/*.json
# Generated TS client manifest — declares the proto-es + Connect peer
# deps so any TS workspace consuming gen/ts/ can resolve them.
!gen/ts/package.json
# Fixture odpowiedzi ElevenLabs — ksztalt prawdziwej odpowiedzi API
# (typy word/spacing, speaker_id, znaczniki czasu) z SYNTETYCZNA trescia.
# Bez tego wyjatku blanketowe *.json zjada plik i TestParse_RealResponseFixture
# przechodzi wylacznie na maszynie autora, a w CI wywala sie na braku pliku.
!services/ai-pipeline-svc/internal/elevenlabs/testdata/*.json
.env
.env.local

# Logs
*.log

# Generated code from `buf generate`.
#   Go (gen/go): only go.mod + go.sum are tracked — *.pb.go are regenerated
#                in CI, no source-controlled artefacts.
#   TS (gen/ts): full output is tracked — Next.js + Flutter Web don't run
#                buf, so the generated clients live in git. Source of
#                truth is proto/; `buf generate` should produce a clean
#                diff against the committed tree.
gen/go/*
!gen/go/go.mod
!gen/go/go.sum

# llm-eval offline matrix outputs + intermediate prompt dumps —
# regenerated on every run, not source code.
services/ai-pipeline-svc/llm-eval-results/
services/ai-pipeline-svc/prompts/
services/ai-pipeline-svc/testdata/

# Temporary feature-branch build config — deleted on merge to main
# per the file's own comment block.
cloudbuild-feature-branch.yaml

# Skompilowane binaria pakietow (go test -c / przypadkowe buildy w katalogu
# pakietu). 20.08.2026 szesc takich binariow (po 1,7 MB) wjechalo do
# historii przez `git add -A` — plik bez rozszerzenia o nazwie katalogu.
pkg/authz/authz
pkg/errors/errors
pkg/idempotency/idempotency
pkg/observability/observability
pkg/pubsubx/pubsubx
pkg/testutil/testutil
