<?xml version="1.0" encoding="utf-8"?>
<!-- F-15 fix: Disable cloud backup and device-to-device transfer
     for ALL app data. SuperWizor handles clinical PHI (audio
     recordings, consent records, upload queue state) — none of
     which should leave the device via Android backup mechanisms.

     android:dataExtractionRules targets Android 12+ (API 31+).
     android:fullBackupContent="false" in AndroidManifest covers
     older API levels. Together they close the backup vector on
     all supported Android versions. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
