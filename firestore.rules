rules_version = '2';

// =============================================================================
// SuperWizor AI — Firestore security rules
// =============================================================================
// Architecture §6: Firestore is a READ-ONLY mirror for the Flutter mobile
// client. The only backend writer is notification-svc using Admin SDK
// (which bypasses these rules). Every other service writes to PostgreSQL,
// which is the source of truth.
//
// Two collections:
//   - session_states/{sessionId}            — live session status mirror
//   - user_notifications/{uid}/inbox/{id}   — per-user notification inbox
//
// Both deny client writes by default. The single exception: a user may set
// `readAt` on their own inbox notification (and ONLY readAt — diff check
// prevents tampering).
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // session_states/{sessionId}
    // -------------------------------------------------------------------------
    // Backend writes status transitions here as the AI pipeline progresses.
    // Therapist's Flutter app subscribes for live "Transcribing... → Done"
    // updates without polling clinical-svc.
    //
    // therapistFirebaseUid is the Firebase UID (NOT users.id PG UUID).
    // Client auth principal is also a Firebase UID — they must match.
    match /session_states/{sessionId} {
      // Two-clause read: (1) any authenticated user may listen for a
      // non-existent doc — Firestore listener has to subscribe BEFORE
      // notification-svc creates the doc, otherwise we get a race
      // window of "permission denied" right after recording stops.
      // (2) once the doc exists, the standard owner check applies.
      // The non-existent branch is safe — Firestore returns null data
      // for missing docs, no information leakage about other sessions.
      allow read: if request.auth != null
                  && (resource == null
                      || request.auth.uid == resource.data.therapistFirebaseUid);
      allow write: if false;  // Admin SDK on backend bypasses this
    }

    // -------------------------------------------------------------------------
    // user_notifications/{uid}/inbox/{notifId}
    // -------------------------------------------------------------------------
    // Per-user notification inbox. User can read their own; can only mark as
    // read (set readAt). Cannot create, delete, or modify any other field.
    match /user_notifications/{uid}/inbox/{notifId} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Only readAt can change. diff().affectedKeys() returns the changed
      // top-level keys; hasOnly enforces nothing else moved.
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);

      allow create, delete: if false;
    }

    // -------------------------------------------------------------------------
    // organization_quota/{organizationId}
    // -------------------------------------------------------------------------
    // Backend (notification-svc.ProcessBillingEvent → fswriter
    // WriteOrganizationQuota) mirrors current quota state here after every
    // outbox quota.* event. Flutter QuotaWarningBanner subscribes for live
    // updates of remaining tokens + warningLevel.
    //
    // Slice 4 access model: any authenticated user can read this doc. We
    // accept this trade-off for MVP because:
    //   * organizationId is a UUID (not enumerable)
    //   * payload contains only counters (no PHI, no PII)
    //   * Flutter currentUserProvider resolves the user's own organizationId
    //     from identity-svc before subscribing — clients never see other
    //     orgs' UUIDs.
    //
    // Slice 5 TODO: strict membership check via a parallel `organization_members/
    // {orgId}/users/{firebaseUid}` collection populated by identity-svc, so
    // rule becomes: exists(/databases/$(database)/documents/organization_members/
    // $(organizationId)/users/$(request.auth.uid)).
    match /organization_quota/{organizationId} {
      allow read: if request.auth != null;
      allow write: if false;  // Admin SDK on backend bypasses this
    }

    // -------------------------------------------------------------------------
    // Default deny — everything else.
    // -------------------------------------------------------------------------
    // Catches any documents we haven't explicitly allowed. Fails closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
