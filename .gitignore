# macOS
.DS_Store
# Spotlight exclusion sentinel — placed in heavy build dirs to keep
# mdsync off the build artifacts. Should never go into git.
.metadata_never_index

# General
.env
node_modules/
build/
coverage/
dist/
.idea/
.vscode/

# Firebase
firebase-debug.log
firebase-debug.*.log

# Temporary agents/claude stuff if we don't want to track them (wait, maybe we should track docs, but let's ignore lock files if needed)
# skills-lock.json (we can track it)

# Frontend / Flutter is probably in frontend/ so it might have its own .gitignore, 
# but just in case we can add standard Flutter ignores here:
.dart_tool/
.packages
.pub-cache/
.pub/
/build/
*.DS_Store
*.swp

# Slice 2 — scripts/node_modules holds puppeteer (~190MB Chromium)
scripts/node_modules/

# Scratch & Logs
scratch/
proxy.log

# Secrets & credentials — NEVER commit (security #4/#18)
# Klucze App Store Connect. Klucz z rola Admin przelezal w origin/main od
# 2026-07-13 do 2026-08-14 (commit 25f61cea) — plik .p8 to klucz PRYWATNY,
# jednorazowo pobierany z Apple i nie do odzyskania. Miejsce na niego to
# ~/private_keys, nigdy repozytorium.
*.p8
**/*.p8
AuthKey_*.p8
# Poswiadczenia wysylki do sklepow. credentials.env trzyma dzis wylacznie
# identyfikatory (Issuer ID, Key ID, sciezka), ale nazwa zapraszała, zeby
# wlozyc tam kiedys sekret.
credentials.env
**/credentials.env
sa-key.json
**/sa-key.json
*-sa-key.json
.env.production
**/.env.production
# Terraform state (routinely contains plaintext secrets) incl. epoch backups
*.tfstate
*.tfstate.*
**/*.tfstate*

