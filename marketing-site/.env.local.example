# marketing-site environment variables.
#
# Copy to `.env.local` (gitignored by Next's default .gitignore) and
# fill in real values for your environment. NEXT_PUBLIC_* prefix means
# the value ships in the browser bundle — anything sensitive (private
# API keys, service-account JSON, server-only DSNs) MUST NOT use this
# prefix.

# ── Connect-RPC backends ───────────────────────────────────────
# Local dev (Go services running on their default ports). Staging /
# prod overrides set these to Cloud Run URLs in the deploy pipeline.
NEXT_PUBLIC_IDENTITY_URL=http://localhost:8080
NEXT_PUBLIC_BILLING_URL=http://localhost:8081
NEXT_PUBLIC_CLINICAL_URL=http://localhost:8082

# ── Firebase Auth ──────────────────────────────────────────────
# Web App config from Firebase Console → Project settings → Your apps.
# These four are required; the optional ones below populate when the
# server-side iOS app config is present.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Set to "1" to route the Web SDK at the local Auth emulator
# (http://127.0.0.1:9099 — port declared in firebase.json). Leave
# unset / "0" for production Firebase.
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=1

# Toggle the dev-only auth status badge in the bottom-right of every
# page. On in dev by default; set to "1" to also show on prod builds.
NEXT_PUBLIC_SHOW_AUTH_BADGE=1
