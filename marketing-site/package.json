{
  "name": "marketing-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "mv src/app/api ../temp_api || true; next build; status=$?; mv ../temp_api src/app/api || true; exit $status",
    "start": "next start",
    "lint": "eslint",
    "check:l10n": "node scripts/check-l10n-parity.mjs",
    "ci": "pnpm run check:l10n && pnpm run lint && pnpm run test && pnpm run build",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1",
    "@hookform/resolvers": "^5.4.0",
    "@nivo/funnel": "^0.99.0",
    "@nivo/heatmap": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@superwizor/proto-ts": "file:../superwizor-backend/gen/ts",
    "firebase": "^12.13.0",
    "framer-motion": "^12.40.0",
    "next": "16.2.6",
    "next-intl": "^4.12.0",
    "react": "19.2.4",
    "react-countup": "^6.5.3",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}
